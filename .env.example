# Storage (any S3-compatible service: R2, AWS S3, MinIO, Backblaze B2)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket-name
S3_REGION=auto

# Path prefix for emails in the bucket
# Tip: use a per-provider prefix, e.g. emails/gmail or emails/outlook
EMAIL_PREFIX=emails/gmail

# Fetcher mode: "imap" | "gmail-api" | "outlook"
FETCHER=imap

# Gmail API (only if FETCHER=gmail-api)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# IMAP (only if FETCHER=imap)
# Gmail:    imap.gmail.com:993  (use app password: myaccount.google.com/apppasswords)
# Fastmail: imap.fastmail.com:993
# Note: personal Outlook.com/Hotmail no longer works here — basic auth / app
#       passwords are dead. Use FETCHER=outlook (OAuth2) instead.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your_app_password

# Outlook / Microsoft personal (only if FETCHER=outlook)
# IMAP for Outlook.com/Hotmail now REQUIRES OAuth2 — this path uses the
# device-code flow (no password handled). First run prints a URL + code to
# sign in; the token is cached to OUTLOOK_TOKEN_PATH and refreshed silently.
OUTLOOK_USER=you@outlook.com
OUTLOOK_TOKEN_PATH=./outlook-token.json
OUTLOOK_MAILBOX=INBOX
